# ZM Systems Environment Variables
# Copy this file to .env and fill in your values

# Supabase PostgreSQL Database
# Use the pooled connection string (port 6543) for DATABASE_URL
DATABASE_URL="postgresql://postgres:your-password@db.your-project.supabase.co:6543/postgres?pgbouncer=true"
# Use the direct connection string (port 5432) for migrations
DIRECT_URL="postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres"

# JWT Secret (change this in production!)
JWT_SECRET="zm-systems-secret-key-change-in-production"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# API Port
PORT=3001
